# Copy this file to .env.local (gitignored) and fill it in.
#
# Local development: run `npm run db:start`; it prints the API URL and the
# publishable key (or run `npx supabase status -o env`). The values below are
# the Supabase CLI's local defaults.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_or_project_key

# Production: use your Supabase project's URL and *publishable* key
# (Project Settings → API keys). Never put the secret/service-role key here.

# Where password-reset emails send people (your deployed web app). The web app
# uses its own origin automatically; native builds need this to be set.
EXPO_PUBLIC_SITE_URL=https://recallmate.netlify.app
