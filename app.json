{
  "expo": {
    "name": "RecallMate",
    "slug": "RecallMate",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recallmate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noahspencercode.RecallMate"
    },
    "android": {
      "package": "com.noahspencercode.recallmate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#6C4DFF",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "RecallMate",
      "shortName": "RecallMate",
      "description": "Spaced-repetition study cards for college students.",
      "backgroundColor": "#0F0B1E"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFF6EC",
          "dark": {
            "backgroundColor": "#0F0B1E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1da22a2b-f32a-45ec-92b9-b774873f78f8"
      }
    }
  }
}
